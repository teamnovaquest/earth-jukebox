d2"},{"t":"cyl","r":0.0042,"h":0.012,"p":[0.32,0.0,0.126],"rot":[90,0,0],"c":"#c3cad2"},{"t":"cyl","r":0.0042,"h":0.012,"p":[0.32,-0.05,0.126],"rot":[90,0,0],"c":"#c3cad2"},{"t":"cyl","r":0.0042,"h":0.012,"p":[0.32,-0.1,0.126],"rot":[90,0,0],"c":"#c3cad2"},{"t":"cyl","r":0.0042,"h":0.012,"p":[0.32,-0.15,0.126],"rot":[90,0,0],"c":"#c3cad2"},{"t":"cyl","r":0.0042,"h":0.012,"p":[0.32,-0.185,0.126],"rot":[90,0,0],"c":"#c3cad2"}],"ex":[0,0,0],"part":{"name":"Stainless steel M4 screws and nuts (A2/304), silicone sealant","ex":"Local hardware shop","qty":6,"price":0.17,"est":true,"url":null}},{"id":"cable","name":"Probe cable","info":"Seven-core cable from the six screws to the box, entering through a cable gland.","shapes":[{"t":"rod","a":[0.32,0.1,0.12],"b":[0.03,0.895,0.05],"r":0.0035,"c":"#26292e"}],"ex":[0,0,0],"part":{"name":"7-core cable, 1.5 m (probes to box)","ex":"Local electrical shop","qty":1,"price":1.5,"est":true,"url":null}},{"id":"stake","name":"Stake","info":"A 1.6 m galvanised pipe or bamboo pole, 30 cm into the soil. The box sits at about 0.95 m, above flood water and within easy reach.","shapes":[{"t":"rod","a":[0,-0.3,0],"b":[0,1.31,0],"r":0.02,"c":"#8b939b"}],"ex":[0,0,0],"part":{"name":"Galvanised pipe or bamboo stake 1.6 m, two hose clamps","ex":"Local hardware shop","qty":1,"price":2.0,"est":true,"url":null}},{"id":"box","name":"IP65 enclosure","info":"Weatherproof box (IP65: dust-tight and protected against water jets) holding all the electronics, clamped to the stake.","shapes":[{"t":"box","s":[0.115,0.1,0.06],"p":[0,0.95,0.05],"c":"#c4cad0"}],"ex":[0,0,0],"part":{"name":"IP65 enclosure, about 115 x 100 x 60 mm, with 2 cable glands","ex":"Local electrical shop","qty":1,"price":5.0,"est":true,"url":null}},{"id":"lid","name":"Enclosure lid","info":"Screwed lid with a rubber seal.","shapes":[{"t":"box","s":[0.115,0.1,0.006],"p":[0,0.95,0.083],"c":"#dfe4e8","o":0.85}],"ex":[0,0.2,0.22],"part":{"name":"IP65 enclosure, about 115 x 100 x 60 mm, with 2 cable glands","ex":"Local electrical shop","qty":1,"price":5.0,"est":true,"url":null}},{"id":"mcu","name":"ESP32 Feather V2 controller","info":"The brain. It wakes every 10 minutes, reads the probes, decides the tune, and goes back to deep sleep at 70 µA. Its Wi-Fi is used once an hour, only if a known network is in range.","shapes":[{"t":"box","s":[0.0523,0.0228,0.0016],"p":[-0.022,0.983,0.052],"c":"#1f2329"},{"t":"box","s":[0.016,0.016,0.0028],"p":[-0.022,0.983,0.0545],"c":"#b9bfc6"}],"ex":[0,0.07,0.17],"part":{"name":"ESP32 Feather V2 (controller, Wi-Fi)","ex":"Adafruit 5400","qty":1,"price":19.95,"est":false,"url":"https://www.adafruit.com/product/5400"}},{"id":"mp3","name":"DFPlayer Mini sound module","info":"Plays the tunes from its microSD card. It is switched off completely between tunes, because idle it would draw about 20 mA.","shapes":[{"t":"box","s":[0.0205,0.0205,0.0016],"p":[0.028,0.983,0.052],"c":"#2b2f36"},{"t":"box","s":[0.011,0.015,0.0012],"p":[0.028,0.983,0.0538],"c":"#3b3f46"}],"ex":[0,0.07,0.17],"part":{"name":"DFPlayer Mini (plays the tunes)","ex":"DFRobot DFR0299","qty":1,"price":5.9,"est":false,"url":"https://www.dfrobot.com/product-1121.html"}},{"id":"chg","name":"Solar charger (DFR0559)","info":"Charges the battery from the panel with maximum power point tracking, and protects it from over-charge and over-discharge.","shapes":[{"t":"box","s":[0.063,0.033,0.0016],"p":[-0.018,0.95,0.05],"c":"#26506f"}],"ex":[0,0,0.17],"part":{"name":"Solar charger with MPPT","ex":"DFRobot DFR0559","qty":1,"price":7.9,"est":false,"url":"https://www.dfrobot.com/product-1712.html"}},{"id":"iface","name":"Interface board","info":"Perfboard with the NDP6020P switch for the sound module, its 2N2222 driver, the probe resistors and the daylight divider.","shapes":[{"t":"box","s":[0.034,0.03,0.0016],"p":[0.036,0.95,0.05],"c":"#c9a76b"},{"t":"box","s":[0.01,0.015,0.0045],"p":[0.036,0.952,0.053],"c":"#1c1c1c"}],"ex":[0,0,0.17],"part":{"name":"NPN transistor 2N2222, resistors (5 x 1 MΩ, 2 x 1 kΩ, 2 x 100 kΩ, 150 kΩ), perfboard, headers, wire","ex":"Local electronics shop","qty":1,"price":1.5,"est":true,"url":null}},{"id":"cell","name":"18650 Li-ion cell in holder","info":"2200 mAh protected cell. The whole stake uses about 38 mAh a day, so a full cell (using 80% of it) lasts about 46 days with no sun at all.","shapes":[{"t":"box","s":[0.077,0.021,0.02],"p":[0,0.914,0.041],"c":"#141414"},{"t":"cyl","r":0.009,"h":0.069,"p":[0,0.914,0.047],"rot":[0,0,90],"c":"#2f74c9"}],"ex":[0,-0.06,0.17],"part":{"name":"Li-ion cell 18650, 2200 mAh, protected","ex":"Adafruit 1781","qty":1,"price":9.95,"est":false,"url":"https://www.adafruit.com/product/1781"}},{"id":"sw","name":"Mode switch","info":"Three positions: Keep flooded (first two weeks and around flowering), AWD (the rest of the season) and Off. The farmer feels the position, no reading needed.","shapes":[{"t":"cyl","r":0.008,"h":0.016,"p":[0.0655,0.97,0.05],"rot":[0,0,90],"c":"#e2a838"}],"ex":[0.07,0,0],"part":{"name":"Sealed 3-position toggle switch (mode)","ex":"Local electrical shop","qty":1,"price":1.5,"est":true,"url":null}},{"id":"glands","name":"Cable glands","info":"Sealed entries for the probe cable and the panel cable.","shapes":[{"t":"cyl","r":0.007,"h":0.012,"p":[0.03,0.894,0.05],"c":"#30343a"},{"t":"cyl","r":0.007,"h":0.012,"p":[-0.03,0.894,0.05],"c":"#30343a"}],"ex":[0,-0.05,0],"part":{"name":"IP65 enclosure, about 115 x 100 x 60 mm, with 2 cable glands","ex":"Local electrical shop","qty":1,"price":5.0,"est":true,"url":null}},{"id":"spk","name":"Speaker (facing down)","info":"3 W speaker hanging under the box and facing the ground, so rain cannot get in and the sound spreads across the field.","shapes":[{"t":"box","s":[0.07,0.017,0.03],"p":[0,0.872,0.05],"c":"#1d1f22"},{"t":"cyl","r":0.011,"h":0.002,"p":[0,0.8625,0.05],"c":"#3a3d42"}],"ex":[0,-0.11,0],"part":{"name":"Speaker, 3 W 4 Ω, enclosed","ex":"Adafruit 3351","qty":1,"price":3.95,"est":false,"url":"https://www.adafruit.com/product/3351"}},{"id":"pv","name":"Solar panel 5 V 6 W","info":"Tilted towards the equator at roughly the local latitude (24 degrees here). Even in December, the cloudiest-sun month at this site in NASA POWER, it gathers many times the energy the stake needs.","shapes":[{"t":"box","s":[0.275,0.0035,0.17],"p":[0,1.335,0.03],"rot":[24,0,0],"c":"#1d2c4c"},{"t":"box","s":[0.279,0.002,0.174],"p":[0,1.333,0.03],"rot":[24,0,0],"c":"#c7ccd2"}],"ex":[0,0.16,0],"part":{"name":"Solar panel 5 V 6 W","ex":"DFRobot FIT0601","qty":1,"price":9.0,"est":false,"url":"https://www.dfrobot.com/product-1774.html"}},{"id":"bracket","name":"Panel bracket","info":"Holds the panel at its tilt.","shapes":[{"t":"rod","a":[0,1.3,0],"b":[0,1.325,0.03],"r":0.01,"c":"#8b939b"}],"ex":[0,0.16,0],"part":{"name":"Galvanised pipe or bamboo stake 1.6 m, two hose clamps","ex":"Local hardware shop","qty":1,"price":2.0,"est":true,"url":null}}]}